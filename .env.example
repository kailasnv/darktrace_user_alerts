# -----------------------------
# Twilio SMS
# -----------------------------
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1xxxxxxxxxx
ALERT_TO_NUMBER=+91xxxxxxxxxx

# -----------------------------
# Firebase Cloud Messaging
# -----------------------------
# Path to the Firebase service-account JSON file.
# Keep this JSON file OUTSIDE Git or add it to .gitignore.
FIREBASE_CREDENTIALS_PATH=./secrets/firebase-service-account.json

# Optional default FCM device token.
# You can also pass fcm_token in the API request.
FCM_DEVICE_TOKEN=your_fcm_device_registration_token

# -----------------------------
# Celery / Redis
# -----------------------------
REDIS_URL=redis://localhost:6379/0

# -----------------------------
# Alert rules
# -----------------------------
# Notifications below this severity are skipped.
# Allowed: low, medium, high, critical
ALERT_MIN_SEVERITY=low

# -----------------------------
# Audit logging
# -----------------------------
AUDIT_LOG_FILE=audit_log.jsonl
