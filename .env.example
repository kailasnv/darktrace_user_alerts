ALERT_ENGINE_DB_URL=sqlite:///./alert_engine.db
ALERT_ENGINE_DB_ECHO=false
ALERT_DEDUP_WINDOW_HOURS=24

ALERT_ENGINE_INGEST_API_KEY=replace-with-a-long-random-secret

TAXII_DISCOVERY_URL=https://your-taxii-server.example.com/taxii2/
TAXII_API_ROOT=https://your-taxii-server.example.com/api/v21
TAXII_COLLECTION_ID=00000000-0000-4000-8000-000000000000
TAXII_USERNAME=replace-me
TAXII_PASSWORD=replace-me
TAXII_VERIFY_TLS=true
TAXII_TIMEOUT_SECONDS=15
TAXII_MAX_RETRIES=3

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
